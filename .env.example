# ============================================================================
# Цветочная База Дубравиных — переменные окружения.
# Скопировать в .env.local и заполнить. Реальные значения в репозиторий не
# коммитятся: .env.local уже в .gitignore.
# ============================================================================

# Публичный адрес сайта. Нужен для canonical, sitemap и Open Graph.
NEXT_PUBLIC_SITE_URL=https://example.com

# --- МойСклад (этап оптового каталога) --------------------------------------
# Токен читается ТОЛЬКО на сервере и никогда не попадает в браузер:
# имени без префикса NEXT_PUBLIC_ достаточно, чтобы Next не отдал его клиенту.
MOYSKLAD_API_TOKEN=
# Идентификатор склада, остатки которого показываем оптовым клиентам.
MOYSKLAD_WAREHOUSE_ID=
# Источник данных каталога: demo | moysklad
CATALOG_SOURCE=demo

# --- Приём заявок -----------------------------------------------------------
# Вебхук CRM или промежуточного сервиса, куда уходят оптовые и корпоративные заявки.
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=

# --- Аналитика --------------------------------------------------------------
# Номер счётчика Яндекс.Метрики. Пустое значение — аналитика не подключается.
NEXT_PUBLIC_YANDEX_METRIKA_ID=
